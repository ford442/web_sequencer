{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyphon.local/schemas/ai-song.schema.json",
  "title": "Hyphon AI song (AISongData v1.0 / v1.1)",
  "description": "Generated by scripts/gen-ai-song-schema.ts from src/importers/ai-song/types.ts. Do not edit by hand; see docs/ai-song-format.md and docs/ai-song-agent-brief.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/AISongDataV1_0"
    },
    {
      "$ref": "#/$defs/AISongDataV1_1"
    }
  ],
  "$defs": {
    "AISongData": {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "author": {
              "type": "string",
              "pattern": "\\S"
            },
            "version": {
              "enum": [
                "1.0",
                "1.1"
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "generator": {
              "type": "string",
              "pattern": "\\S"
            },
            "prompt": {
              "type": "string",
              "pattern": "\\S"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "author",
            "version",
            "createdAt",
            "generator",
            "prompt"
          ],
          "additionalProperties": false,
          "description": "Metadata about the song and generation"
        },
        "globals": {
          "type": "object",
          "properties": {
            "tempo": {
              "type": "number",
              "minimum": 30,
              "maximum": 300
            },
            "timeSignature": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[numerator, denominator] — optional, defaults to [4, 4]"
            },
            "swing": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "stepCount": {
              "type": "integer",
              "description": "v1.1: steps per pattern / measure (1-64), defaults to 32",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "tempo"
          ],
          "additionalProperties": false,
          "description": "Global song settings"
        },
        "tracks": {
          "$ref": "#/$defs/AISongTracks",
          "description": "Track patterns. Required in v1.0; in v1.1 either this (one pattern, `\"A\"`) or `patterns`."
        },
        "patterns": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AIPatternData"
          },
          "description": "v1.1: named patterns, referenced by id from `song` rows",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "\\S"
          }
        },
        "song": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AISongRow"
          },
          "description": "v1.1: the arrangement, one row per measure",
          "minItems": 1
        },
        "automation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AIAutomationLane"
          },
          "description": "Optional automation lanes. With `patterns`, these are song-wide: they repeat every measure."
        }
      },
      "required": [
        "meta",
        "globals"
      ],
      "additionalProperties": false,
      "description": "Standard format for AI-generated songs. Designed to be simple for AIs to generate while being unambiguous to parse.\n\nv1.0 is one pattern (`tracks`). v1.1 adds an optional song block: `patterns` (named) + `song` (one row per measure) + `globals.stepCount`."
    },
    "AISongFormatVersion": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "`meta.version` values this build reads (see `versioning.ts`)."
    },
    "AISongTracks": {
      "type": "object",
      "properties": {
        "synthA": {
          "$ref": "#/$defs/AITrackData",
          "description": "TB-303 style lead/bass"
        },
        "synthB": {
          "$ref": "#/$defs/AITrackData",
          "description": "TB-303 style secondary"
        },
        "bass2": {
          "$ref": "#/$defs/AITrackData",
          "description": "Second 303 bass"
        },
        "kick": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "description": "Drum patterns (true = hit)"
        },
        "snare": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "closedHat": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "openHat": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "sampler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AISamplerBankData"
          },
          "description": "Sampler banks (8 max)",
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "description": "One pattern's worth of tracks — the v1.0 `tracks` shape."
    },
    "AITrackData": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AINoteEvent"
          }
        },
        "params": {
          "type": "object",
          "properties": {
            "waveform": {
              "$ref": "#/$defs/Waveform"
            },
            "pitch": {
              "type": "number"
            },
            "filterCutoff": {
              "type": "number"
            },
            "filterResonance": {
              "type": "number"
            },
            "filterMode": {
              "type": "number"
            },
            "drive": {
              "type": "number"
            },
            "attack": {
              "type": "number"
            },
            "decay": {
              "type": "number"
            },
            "sustain": {
              "type": "number"
            },
            "release": {
              "type": "number"
            },
            "length": {
              "type": "number"
            },
            "volume": {
              "type": "number"
            },
            "pan": {
              "type": "number"
            },
            "delayTime": {
              "type": "number"
            },
            "delayFeedback": {
              "type": "number"
            },
            "delayMix": {
              "type": "number"
            },
            "engine303": {
              "$ref": "#/$defs/Engine303",
              "description": "Legacy DSP engine field for '303-saw'/'303-sqr' waveforms. Superseded by model303 but still written on save so older builds load songs correctly."
            },
            "model303": {
              "$ref": "#/$defs/TB303ModelId",
              "description": "Selected 303 voice/model (see engines/TB303Models.ts). Defaults to 'stock-open303'."
            },
            "model303Extra": {
              "$ref": "#/$defs/TB303VoiceExtra",
              "description": "Per-song state for the high-fid voice: live A/B + diode-ladder coefficients (L2/L3)."
            },
            "pitchAttack": {
              "type": "number",
              "description": "Prophecy: Vowel formant preset 0–4 (A=0, E=1, I=2, O=3, U=4)"
            },
            "pitchDecay": {
              "type": "number"
            },
            "pitchAmount": {
              "type": "number"
            },
            "vowel": {
              "type": "number"
            },
            "portamento": {
              "type": "number",
              "description": "Prophecy: Portamento rate 0–1 (0=instantaneous, 1=max glide)"
            },
            "formantShift": {
              "type": "number",
              "description": "Prophecy: Formant frequency shift 0–1"
            },
            "formantPitchLink": {
              "type": "number"
            },
            "coarseTune": {
              "type": "number"
            },
            "fineTune": {
              "type": "number"
            },
            "cppFine": {
              "type": "number",
              "deprecated": true,
              "description": "Deprecated: CPP oscillator family removed (#1294); kept so old songs load."
            },
            "macro": {
              "$ref": "#/$defs/MacroSynthParams",
              "description": "Macro engine knobs — only read when `waveform` is a `macro-*` id."
            }
          },
          "additionalProperties": false
        },
        "harmonizer": {
          "$ref": "#/$defs/AIHarmonizerConfig"
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": false,
      "description": "Single track data from AI"
    },
    "AINoteEvent": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "note": {
          "type": "string",
          "pattern": "^[A-G][#b]?[0-8]$"
        },
        "velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "length": {
          "type": "number",
          "minimum": 1
        },
        "accent": {
          "type": "boolean"
        },
        "slide": {
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "note"
      ],
      "additionalProperties": false,
      "description": "Note event in AI format"
    },
    "Waveform": {
      "anyOf": [
        {
          "type": "string",
          "const": "sawtooth"
        },
        {
          "type": "string",
          "const": "square"
        },
        {
          "type": "string",
          "const": "triangle"
        },
        {
          "type": "string",
          "const": "sine"
        },
        {
          "type": "string",
          "const": "pyodide-saw"
        },
        {
          "type": "string",
          "const": "pyodide-square"
        },
        {
          "type": "string",
          "const": "pyodide-sine"
        },
        {
          "type": "string",
          "const": "wgsl-saw"
        },
        {
          "type": "string",
          "const": "wgsl-sqr"
        },
        {
          "type": "string",
          "const": "wgsl-tri"
        },
        {
          "type": "string",
          "const": "wgsl-sin"
        },
        {
          "type": "string",
          "const": "wam-saw"
        },
        {
          "type": "string",
          "const": "wam-sqr"
        },
        {
          "type": "string",
          "const": "wam-tri"
        },
        {
          "type": "string",
          "const": "wam-sin"
        },
        {
          "type": "string",
          "const": "wav-saw"
        },
        {
          "type": "string",
          "const": "wav-sqr"
        },
        {
          "type": "string",
          "const": "303-saw"
        },
        {
          "type": "string",
          "const": "303-sqr"
        },
        {
          "type": "string",
          "const": "prophecy-saw"
        },
        {
          "type": "string",
          "const": "prophecy-sqr"
        },
        {
          "type": "string",
          "const": "prophecy-tri"
        },
        {
          "type": "string",
          "const": "prophecy-pulse"
        },
        {
          "$ref": "#/$defs/MacroWaveform"
        }
      ],
      "description": "Selectable oscillator waveforms. Every prefix here resolves to a live engine through `parseWaveform` + `ENGINE_CATALOG` (#1294) — nothing in this union falls through to an undocumented `OscillatorNode`.\n\n`rust-*` and `cpp-*` were removed: neither had a worklet, both dumped (or in cpp's case, failed to dump) a buffer on the main thread. Saved songs that still contain them are rewritten by `LEGACY_WAVEFORM_ALIASES` (whose keys are plain strings — the ids are no longer members of this union).\n\n`macro-*` are the 24 models of the macro engine family (Plaits DSP, MIT) — the id names the model; `SynthParams.macro` carries its knobs. The order and ids are persisted: see MACRO_ENGINES in engines/MacroParams.ts.\n\n`wam-*` is Hyphon's AssemblyScript wavetable kernel and is labelled \"WASM OSC\" in the UI — it is NOT Web Audio Modules 2.0 (ADR 0001). The ids keep the `wam-` prefix so existing projects keep loading."
    },
    "MacroWaveform": {
      "type": "string",
      "enum": [
        "macro-va-vcf",
        "macro-phase-dist",
        "macro-fm6-a",
        "macro-fm6-b",
        "macro-fm6-c",
        "macro-wave-terrain",
        "macro-string-machine",
        "macro-chiptune",
        "macro-va",
        "macro-waveshaper",
        "macro-fm2",
        "macro-grain",
        "macro-additive",
        "macro-wavetable",
        "macro-chords",
        "macro-speech",
        "macro-swarm",
        "macro-noise",
        "macro-particle",
        "macro-string",
        "macro-modal",
        "macro-bass-drum",
        "macro-snare",
        "macro-hihat"
      ],
      "description": "The macro engine family, in native engine order (MACRO_ENGINES)."
    },
    "Engine303": {
      "type": "string",
      "enum": [
        "open303",
        "jc303"
      ],
      "description": "TB-303 DSP engine selection.\n- 'open303': custom synthesizer (open303_wrapper.cpp, open303_* API)\n- 'jc303':   authentic rosic::Open303 (jc303_wrapper.cpp, jc303_* API)"
    },
    "TB303ModelId": {
      "type": "string",
      "enum": [
        "stock-open303",
        "jc303",
        "rebirth-338-1.5",
        "rebirth-2.0",
        "mb33-mkii",
        "raveolution",
        "1ink303-v1",
        "experimental-01",
        "live-highfid",
        "highfid-cpu",
        "gpu-highfid"
      ]
    },
    "TB303VoiceExtra": {
      "type": "object",
      "properties": {
        "ab": {
          "$ref": "#/$defs/LiveAbSettings",
          "description": "Live A/B (Phase L2). Only meaningful while `model303` is `live-highfid`."
        },
        "highFidCoefficients": {
          "$ref": "#/$defs/HighFidCoefficients",
          "description": "Diode-ladder coefficients (Phase L3). Absent = canonical preset; a song only carries this once the user moved a coefficient."
        }
      },
      "additionalProperties": false
    },
    "LiveAbSettings": {
      "type": "object",
      "properties": {
        "armed": {
          "type": "boolean",
          "description": "A/B requested. Only engages while the part plays `live-highfid`."
        },
        "mix": {
          "type": "number",
          "description": "Equal-power blend: 0 = stock Open303 (A), 1 = live high-fid (B)."
        }
      },
      "required": [
        "armed",
        "mix"
      ],
      "additionalProperties": false,
      "description": "Persisted A/B request for one 303 part (see `TB303VoiceExtra.ab`)."
    },
    "HighFidCoefficients": {
      "type": "object",
      "properties": {
        "transistorMismatch": {
          "type": "number",
          "description": "Pole spread between the four ladder stages (0 = matched transistors)."
        },
        "decayCurve": {
          "type": "number",
          "description": "Filter-envelope shape (0 = plain exponential, 1 = snappy / concave)."
        },
        "accentCoupling": {
          "type": "number",
          "description": "Accent envelope → cutoff coupling."
        },
        "filterTracking": {
          "type": "number",
          "description": "Keyboard follow of the cutoff (0 = none, 1 = full 1 V/oct)."
        }
      },
      "required": [
        "transistorMismatch",
        "decayCurve",
        "accentCoupling",
        "filterTracking"
      ],
      "additionalProperties": false,
      "description": "liveHighFidCoefficients.ts — editable diode-ladder coefficients (Phase L3).\n\nFour extra `highfid303_set_param` ids on top of the Open303Param ids the live voice already mirrors. They are implemented identically in emscripten/highfid303_wrapper.cpp (live voice + native gates) and in the TS port OfflineHighFid303Engine (freeze / export worker).\n\nThe **canonical preset** reproduces the pre-L3 DSP bit for bit, so every spectrogram / RMS gate keeps measuring the same voice. Gates must drive the canonical preset explicitly (or nothing), never values taken from the UI.\n\nThis file is imported by the AudioWorklet, so it must stay free of DOM and main-thread-only APIs."
    },
    "MacroSynthParams": {
      "type": "object",
      "properties": {
        "harmonics": {
          "type": "number",
          "description": "0–1, meaning per model (MACRO_ENGINES[i].knobs)."
        },
        "timbre": {
          "type": "number"
        },
        "morph": {
          "type": "number"
        },
        "decay": {
          "type": "number",
          "description": "0–1: LPG release in gate mode, the whole envelope in ping mode."
        },
        "lpgColour": {
          "type": "number",
          "description": "0 = VCA, 1 = low-pass gate."
        },
        "polyphony": {
          "type": "number",
          "description": "1–8 voices; 1 = mono with legato slides."
        },
        "fmMod": {
          "type": "number",
          "description": "Internal decay envelope → pitch / TIMBRE / MORPH, −1…1."
        },
        "timbreMod": {
          "type": "number"
        },
        "morphMod": {
          "type": "number"
        },
        "spread": {
          "type": "number",
          "description": "Stereo width from the AUX output, 0–1."
        },
        "glide": {
          "type": "number",
          "description": "Portamento 0–1 (0 = off, 1 ≈ 1 s)."
        },
        "lpgMode": {
          "type": "string",
          "enum": [
            "gate",
            "ping"
          ],
          "description": "'gate' holds the LPG open for the note's length; 'ping' strikes it like the module."
        },
        "auxMix": {
          "type": "number",
          "description": "OUT → AUX crossfade on the mid channel, 0–1."
        }
      },
      "additionalProperties": false,
      "description": "Knobs of a `macro-*` part (engines/MacroParams.ts). Every field is optional so older songs and partial presets load; missing ones take DEFAULT_MACRO_PARAMS. The model itself is the waveform id, not a field here."
    },
    "AIHarmonizerConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "voices": {
          "type": "number",
          "enum": [
            2,
            3,
            4
          ]
        },
        "harmonyType": {
          "type": "string",
          "enum": [
            "octave",
            "fifth",
            "third",
            "seventh",
            "cluster",
            "custom"
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "formantShift": {
          "type": "number"
        },
        "detune": {
          "type": "number"
        },
        "spread": {
          "type": "number"
        }
      },
      "required": [
        "enabled",
        "voices",
        "harmonyType",
        "formantShift",
        "detune",
        "spread"
      ],
      "additionalProperties": false,
      "description": "Harmonizer configuration for vocal/synth tracks"
    },
    "AISamplerBankData": {
      "type": "object",
      "properties": {
        "bankIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AINoteEvent"
          }
        },
        "params": {
          "type": "object",
          "properties": {
            "grainJitter": {
              "type": "number"
            },
            "sampleName": {
              "type": "string"
            },
            "playbackSpeed": {
              "type": "number"
            },
            "volume": {
              "type": "number"
            },
            "filterCutoff": {
              "type": "number"
            },
            "filterResonance": {
              "type": "number"
            },
            "drive": {
              "type": "number"
            },
            "delaySend": {
              "type": "number"
            },
            "mode": {
              "type": "string",
              "enum": [
                "loop",
                "stretch",
                "wavetable"
              ]
            },
            "grainSize": {
              "type": "number"
            },
            "timeRatio": {
              "type": "number"
            },
            "pitchScale": {
              "type": "number"
            },
            "formantShift": {
              "type": "number"
            },
            "formantPitchLink": {
              "type": "number"
            },
            "coarseTune": {
              "type": "number"
            },
            "fineTune": {
              "type": "number"
            },
            "vibratoDepth": {
              "type": "number"
            },
            "tremoloDepth": {
              "type": "number"
            },
            "tremoloRate": {
              "type": "number"
            },
            "breathIntensity": {
              "type": "number"
            },
            "consonantClarity": {
              "type": "number"
            },
            "consonantSaturation": {
              "type": "number"
            },
            "sliceMode": {
              "type": "string",
              "enum": [
                "off",
                "phoneme"
              ]
            },
            "choir": {
              "type": "number"
            },
            "glitchChance": {
              "type": "number"
            },
            "dynamicChops": {
              "type": "boolean"
            },
            "freeze": {
              "type": "number"
            },
            "portamentoType": {
              "type": "string",
              "enum": [
                "linear",
                "exponential"
              ]
            },
            "freezeLfoRate": {
              "type": "number"
            },
            "freezeLfoSync": {
              "type": "boolean"
            },
            "freezeLfoDepth": {
              "type": "number"
            },
            "freezeEnvDepth": {
              "type": "number"
            },
            "timeStretchEnvDepth": {
              "type": "number"
            },
            "grainPitchEnvDepth": {
              "type": "number"
            },
            "grainEnvDepth": {
              "type": "number"
            },
            "grainLfoRate": {
              "type": "number"
            },
            "grainLfoDepth": {
              "type": "number"
            },
            "grainPosLfoDepth": {
              "type": "number"
            },
            "timeSmear": {
              "type": "number"
            },
            "grainPitchQuantize": {
              "type": "number"
            },
            "grainPanSpread": {
              "type": "number"
            },
            "granularPitchShift": {
              "type": "number"
            },
            "windowShape": {
              "type": "number"
            },
            "customGrainEnvelope": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "formantLfoSync": {
              "type": "boolean"
            },
            "volumeFilterMod": {
              "type": "number"
            },
            "formantLfoRate": {
              "type": "number"
            },
            "formantLfoDepth": {
              "type": "number"
            },
            "customLfoShape": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "customWindowShape": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "reverbLfoRate": {
              "type": "number"
            },
            "reverbLfoDepth": {
              "type": "number"
            },
            "bitcrush": {
              "type": "number"
            },
            "spectralComp": {
              "type": "number"
            },
            "subHarmonics": {
              "type": "number"
            },
            "vocalChorus": {
              "type": "number"
            },
            "vocoder": {
              "type": "number"
            },
            "spatialRouting": {
              "type": "number"
            },
            "phonemeDelayAmount": {
              "type": "number"
            },
            "phonemeDelayFeedback": {
              "type": "number"
