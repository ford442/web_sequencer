{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyphon.local/schemas/session-pack.schema.json",
  "title": "Hyphon session pack (hyphon-session-pack v1)",
  "description": "Generated by scripts/gen-session-pack-schema.ts from src/session/pack/schema.ts. Do not edit by hand; see docs/session-pack-format.md. This is the current version — older files are upgraded by migrateSessionPack before they are validated.",
  "type": "object",
  "properties": {
    "format": {
      "const": "hyphon-session-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug. If it collides with another pack on import it is suffixed (-2, -3, …)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "author": {
      "type": "string",
      "minLength": 0,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
    },
    "session": {
      "$ref": "#/$defs/Session",
      "description": "The Session Launcher document: quantization, one column of clips per track, scenes."
    },
    "trackStorage": {
      "$ref": "#/$defs/TrackStorage"
    },
    "instruments": {
      "type": "object",
      "properties": {
        "synthA": {
          "$ref": "#/$defs/SynthSettings"
        },
        "synthB": {
          "$ref": "#/$defs/SynthSettings"
        }
      },
      "additionalProperties": false,
      "description": "SYNTH A / B settings the clips were written for; applied when the pack is loaded."
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "session",
    "trackStorage"
  ],
  "additionalProperties": false,
  "$defs": {
    "Session": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "quantization": {
          "enum": [
            "immediate",
            "step",
            "beat",
            "bar",
            "2bars",
            "4bars"
          ]
        },
        "columns": {
          "type": "object",
          "properties": {
            "partA": {
              "$ref": "#/$defs/Column"
            },
            "partB": {
              "$ref": "#/$defs/Column"
            },
            "bass2": {
              "$ref": "#/$defs/Column"
            },
            "kick": {
              "$ref": "#/$defs/Column"
            },
            "snare": {
              "$ref": "#/$defs/Column"
            },
            "closedHat": {
              "$ref": "#/$defs/Column"
            },
            "openHat": {
              "$ref": "#/$defs/Column"
            },
            "sampler": {
              "$ref": "#/$defs/Column"
            }
          },
          "required": [
            "partA",
            "partB",
            "bass2",
            "kick",
            "snare",
            "closedHat",
            "openHat",
            "sampler"
          ],
          "additionalProperties": false
        },
        "scenes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9:_.-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
              },
              "clipIds": {
                "type": "object",
                "properties": {
                  "partA": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "partB": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "bass2": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "kick": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "snare": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "closedHat": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "openHat": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  },
                  "sampler": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9:_.-]+$"
                  }
                },
                "additionalProperties": false,
                "description": "Clip id per track; null / missing = leave that track alone on scene launch."
              }
            },
            "required": [
              "id",
              "name",
              "clipIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "quantization",
        "columns",
        "scenes"
      ],
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "properties": {
        "track": {
          "enum": [
            "partA",
            "partB",
            "bass2",
            "kick",
            "snare",
            "closedHat",
            "openHat",
            "sampler"
          ]
        },
        "clips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9:_.-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
              },
              "slotIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "launchMode": {
                "enum": [
                  "trigger",
                  "gate",
                  "toggle",
                  "one-shot"
                ]
              },
              "followAction": {
                "enum": [
                  "none",
                  "next",
                  "previous",
                  "random",
                  "stop",
                  "repeat"
                ]
              },
              "followRepeatN": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "empty": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "slotIndex",
              "launchMode",
              "followAction",
              "followRepeatN",
              "empty"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "track",
        "clips"
      ],
      "additionalProperties": false
    },
    "TrackStorage": {
      "type": "object",
      "properties": {
        "partA": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "partB": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "bass2": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "kick": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "snare": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "closedHat": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "openHat": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PatternSlot"
          }
        },
        "sampler": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/SamplerSlot"
          }
        }
      },
      "additionalProperties": false,
      "description": "Pattern slots per track, index = slot number (0-based). null / missing = empty slot. The sampler holds banks: each slot is an array of up to 8 patterns, one per bank."
    },
    "PatternSlot": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "automation": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,47}$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "Pattern": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "automation": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,47}$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "SamplerSlot": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/Pattern"
      }
    },
    "Step": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "note": {
          "type": "string",
          "pattern": "^([A-G])(#{1,2}|x|b{1,2}|♯{1,2}|♭{1,2}|𝄪|𝄫)?(-1|[0-9])$"
        },
        "velocity": {
          "$ref": "#/$defs/Number_0_1"
        },
        "chord": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^([A-G])(#{1,2}|x|b{1,2}|♯{1,2}|♭{1,2}|𝄪|𝄫)?(-1|[0-9])$"
          }
        },
        "slideType": {
          "enum": [
            "linear",
            "exponential"
          ]
        },
        "reverbType": {
          "enum": [
            "room",
            "plate",
            "hall"
          ]
        },
        "phonemes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Phoneme"
          }
        },
        "slide": {
          "type": "boolean"
        },
        "slideFormant": {
          "type": "boolean"
        },
        "isHarmonyVoice": {
          "type": "boolean"
        },
        "reverse": {
          "type": "boolean"
        },
        "dynamicChops": {
          "type": "boolean"
        },
        "formantLfoSync": {
          "type": "boolean"
        },
        "freezeLfoSync": {
          "type": "boolean"
        },
        "formantEnvSync": {
          "type": "boolean"
        },
        "customLfoShape": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/Number_n1000000_1000000"
          }
        },
        "customWindowShape": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/Number_n1000000_1000000"
          }
        },
        "customGrainEnvelope": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/Number_n1000000_1000000"
          }
        },
        "pan": {
          "$ref": "#/$defs/Number_n1_1"
        },
        "length": {
          "$ref": "#/$defs/Number_0_256"
        },
        "probability": {
          "$ref": "#/$defs/Number_0_1"
        },
        "microtiming": {
          "$ref": "#/$defs/Number_n2_2"
        },
        "retrigger": {
          "$ref": "#/$defs/Number_0_64"
        },
        "glitchChance": {
          "$ref": "#/$defs/Number_0_1"
        },
        "sliceIndex": {
          "$ref": "#/$defs/Number_n1_1023"
        }
      },
      "required": [
        "note",
        "velocity"
      ],
      "propertyNames": {
        "enum": [
          "note",
          "velocity",
          "chord",
          "slideType",
          "reverbType",
          "phonemes",
          "slide",
          "slideFormant",
          "isHarmonyVoice",
          "reverse",
          "dynamicChops",
          "formantLfoSync",
          "freezeLfoSync",
          "formantEnvSync",
          "customLfoShape",
          "customWindowShape",
          "customGrainEnvelope",
          "pan",
          "length",
          "slideFromMidi",
          "slideFromFormant",
          "characterMorph",
          "timbre",
          "probability",
          "microtiming",
          "retrigger",
          "glitchChance",
          "sliceIndex",
          "freeze",
          "formantShift",
          "formantPitchLink",
          "coarseTune",
          "fineTune",
          "formantLfoRate",
          "formantLfoDepth",
          "freezeLfoRate",
          "freezeLfoDepth",
          "freezeEnvDepth",
          "timeStretchEnvDepth",
          "grainPitchEnvDepth",
          "grainJitter",
          "grainPitchQuantize",
          "grainEnvDepth",
          "grainLfoRate",
          "grainLfoDepth",
          "grainPosLfoDepth",
          "timeSmear",
          "grainPanSpread",
          "volumeFilterMod",
          "vibratoDepth",
          "reverbSend",
          "reverbLfoRate",
          "reverbLfoDepth",
          "bitcrush",
          "spectralComp",
          "downsample",
          "phonemeFilterMod",
          "delayLfoRate",
          "delayLfoDepth",
          "delaySend",
          "granularPitchShift",
          "windowShape",
          "choir",
          "drive",
          "tranceGate",
          "subHarmonics",
          "vocalChorus",
          "vocoder",
          "phonemeDelayAmount",
          "phonemeDelayFeedback",
          "transientExtraction",
          "consonantClarity",
          "consonantSaturation",
          "autoTune",
          "microtonalVariance",
          "drumDuckDepth",
          "formantEnvAttack",
          "formantEnvDecay",
          "formantEnvAmount",
          "formantEnvFollower",
          "formantSidechainDepth",
          "envMod",
          "filterCutoff",
          "filterResonance",
          "gateRate",
          "gateDepth",
          "spectralPanRate",
          "spectralPanDepth",
          "vocoderMix",
          "vocoderFormantShift",
          "vocoderPreservation",
          "vocoderAttack",
          "vocoderRelease",
          "tremoloDepth",
          "tremoloRate",
          "breathIntensity",
          "pitchAttack",
          "pitchDecay",
          "pitchAmount",
          "vowel",
          "portamento",
          "spatialRouting"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/Number_n1000000_1000000"
      },
      "description": "One step: a note, or null for an empty step. Fields other than note, velocity, chord, slideType, reverbType, phonemes, the booleans and curves (and the ranged numbers pan, length, probability, microtiming, retrigger, glitchChance, sliceIndex) are numbers within ±1e6."
    },
    "Phoneme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$"
        },
        "start": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "end": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "pitchBend": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "vibratoDepth": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "vibratoRate": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "volume": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "grainJitter": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "formantShift": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "grainSize": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        },
        "elasticity": {
          "$ref": "#/$defs/Number_n1000000_1000000"
        }
      },
      "required": [
        "id",
        "symbol",
        "start",
        "end",
        "pitchBend"
      ],
      "additionalProperties": false
    },
    "SynthSettings": {
      "type": "object",
      "properties": {
        "waveform": {
          "enum": [
            "sawtooth",
            "square",
            "triangle",
            "sine",
            "pyodide-saw",
            "pyodide-square",
            "pyodide-sine",
            "wgsl-saw",
            "wgsl-sqr",
            "wgsl-tri",
            "wgsl-sin",
            "wam-saw",
            "wam-sqr",
            "wam-tri",
            "wam-sin",
            "wav-saw",
            "wav-sqr",
            "303-saw",
            "303-sqr",
            "prophecy-saw",
            "prophecy-sqr",
            "prophecy-tri",
            "prophecy-pulse",
            "macro-va-vcf",
            "macro-phase-dist",
            "macro-fm6-a",
            "macro-fm6-b",
            "macro-fm6-c",
            "macro-wave-terrain",
            "macro-string-machine",
            "macro-chiptune",
            "macro-va",
            "macro-waveshaper",
            "macro-fm2",
            "macro-grain",
            "macro-additive",
            "macro-wavetable",
            "macro-chords",
            "macro-speech",
            "macro-swarm",
            "macro-noise",
            "macro-particle",
            "macro-string",
            "macro-modal",
            "macro-bass-drum",
            "macro-snare",
            "macro-hihat"
          ]
        },
        "engine303": {
          "enum": [
            "open303",
            "jc303"
          ]
        },
        "model303": {
          "enum": [
            "stock-open303",
            "jc303",
            "1ink303-v1",
            "experimental-01",
            "rebirth-338-1.5",
            "rebirth-2.0",
            "mb33-mkii",
            "raveolution",
            "openrb338-vintage",
            "openrb338-2.0",
            "live-highfid",
            "highfid-cpu",
            "gpu-highfid"
          ]
        },
        "macro": {
          "type": "object",
          "properties": {
            "harmonics": {
              "$ref": "#/$defs/Number_0_1"
            },
            "timbre": {
              "$ref": "#/$defs/Number_0_1"
            },
            "morph": {
              "$ref": "#/$defs/Number_0_1"
            },
            "decay": {
              "$ref": "#/$defs/Number_0_1"
            },
            "lpgColour": {
              "$ref": "#/$defs/Number_0_1"
            },
            "fmMod": {
              "$ref": "#/$defs/Number_n1_1"
            },
            "timbreMod": {
              "$ref": "#/$defs/Number_n1_1"
            },
            "morphMod": {
              "$ref": "#/$defs/Number_n1_1"
            },
            "spread": {
              "$ref": "#/$defs/Number_0_1"
            },
            "glide": {
              "$ref": "#/$defs/Number_0_1"
            },
            "auxMix": {
              "$ref": "#/$defs/Number_0_1"
            },
            "polyphony": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "lpgMode": {
              "enum": [
                "gate",
                "ping"
              ]
            }
          },
          "additionalProperties": false
        },
        "pitch": {
          "$ref": "#/$defs/Number_n48_48"
        },
        "filterCutoff": {
          "$ref": "#/$defs/Number_20_20000"
        },
        "filterResonance": {
          "$ref": "#/$defs/Number_0_40"
        },
        "filterMode": {
          "$ref": "#/$defs/Number_0_1"
        },
        "drive": {
          "$ref": "#/$defs/Number_0_1"
        },
        "attack": {
          "$ref": "#/$defs/Number_0_10"
        },
        "decay": {
          "$ref": "#/$defs/Number_0_10"
        },
        "sustain": {
          "$ref": "#/$defs/Number_0_1"
        },
        "release": {
          "$ref": "#/$defs/Number_0_10"
        },
        "length": {
          "$ref": "#/$defs/Number_0_10"
        },
        "volume": {
          "$ref": "#/$defs/Number_0_2"
