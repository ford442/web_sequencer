{
  "$comment": [
    "Declared export surface of public/hyphon_native.wasm.",
    "`required` exports are called by shipped worklet / engine code — a build that",
    "drops one of them is broken, and tools/check_wasm_export_map.mjs fails CI.",
    "`optional` exports may be absent from a release build (pruned or profile-gated);",
    "their presence is fine, their absence is not an error.",
    "Anything present in the export map but listed in neither bucket is reported as",
    "unexpected export bloat."
  ],
  "required": [
    "malloc",
    "free",
    "open303_create",
    "open303_destroy",
    "open303_init",
    "open303_note_on",
    "open303_note_off",
    "open303_all_notes_off",
    "open303_set_param",
    "open303_set_oversample",
    "open303_get_oversample",
    "open303_process",
    "open303_get_model_count",
    "open303_get_model_id",
    "open303_get_model_label",
    "open303_get_model_engine",
    "open303_set_model",
    "open303_get_model",
    "open303_find_model_index",
    "open303_set_model_by_id",
    "jc303_create",
    "jc303_destroy",
    "jc303_init_handle",
    "jc303_note_on",
    "jc303_note_off",
    "jc303_all_notes_off",
    "jc303_set_param",
    "jc303_process_handle",
    "prophecy_create",
    "prophecy_destroy",
    "prophecy_init",
    "prophecy_note_on",
    "prophecy_note_off",
    "prophecy_all_notes_off",
    "prophecy_set_param",
    "prophecy_process"
  ],
  "optional": [
    "pthread_self",
    "_emscripten_tls_init",
    "_embind_initialize_bindings",
    "_emscripten_thread_init",
    "_emscripten_thread_crashed",
    "_emscripten_thread_exit",
    "main",
    "highfid303_create",
    "highfid303_destroy",
    "highfid303_init",
    "highfid303_note_on",
    "highfid303_note_off",
    "highfid303_all_notes_off",
    "highfid303_set_param",
    "highfid303_set_oversample",
    "highfid303_get_oversample",
    "highfid303_process",
    "highfid303_engine_id",
    "jc303_init",
    "jc303_noteOn",
    "jc303_noteOff",
    "jc303_allNotesOff",
    "jc303_setWaveform",
    "jc303_setCutoff",
    "jc303_setResonance",
