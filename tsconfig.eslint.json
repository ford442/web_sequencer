{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "vitest.setup.ts",
    "vitest.setup.*.ts",
    "vitest.*.config.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ],
  // Lint every file, worklet sources included; the app project's exclude is
  // only about which lib each file is type-checked against (tsc -b).
  "exclude": []
}
